NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# URL of your LanguageTool service; grammar requests append /v2/check.
LANGUAGETOOL_URL=http://localhost:8010
# Use none for separate Vercel/Render sites; production HTTPS is required. Local default is lax.
SESSION_COOKIE_SAME_SITE=lax
# Required in production; use the trusted proxy hop count (0 for direct traffic).
TRUST_PROXY=0
