        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Note\"",
        "sql": "CREATE TABLE \"public\".\"Note\" (\n  \"content\" text NOT NULL,\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"updatedAt\" timestamptz(3) NOT NULL,\n  CONSTRAINT \"Note_pkey\" PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Note\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Note\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Note\""
