# Keep the application source in the client and server directories.
/*
!/server/
!/.gitignore
!/client/

# Keep local secrets and environment-specific files out of Git.
/server/.env
/server/.env.*
!/server/.env.example

# Ignore generated and machine-specific server files.
/server/node_modules/
/server/dist/
/server/coverage/
/server/*.tsbuildinfo
/server/**/*.tsbuildinfo
/server/**/*.log
/server/.DS_Store
/server/.idea/
/server/.vscode/
.codex
.aws
.agents
